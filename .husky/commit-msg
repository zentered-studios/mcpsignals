# Entire CLI: strip trailer if no user content (allows aborting empty commits)
if command -v entire >/dev/null 2>&1; then entire hooks git commit-msg "$1" || true; else :; fi
# Only lint a message that still has content; git aborts an empty one itself.
if grep -qvE '^[[:space:]]*(#|$)' "$1"; then npx commitlint --edit "$1"; fi
