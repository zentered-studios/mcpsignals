npx biome check --staged --no-errors-on-unmatched
npx oxlint

# Ruff on staged Python files. The version constraint must track the dev group
# in packages/python/pyproject.toml. Missing uvx only warns: CI's python-lint
# job is the enforcement.
staged_py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -n "$staged_py" ]; then
  if command -v uvx >/dev/null 2>&1; then
    echo "$staged_py" | xargs uvx --from 'ruff>=0.15,<0.16' ruff format --check -- || exit 1
    echo "$staged_py" | xargs uvx --from 'ruff>=0.15,<0.16' ruff check -- || exit 1
  else
    echo "pre-commit: uvx not found, skipping ruff on staged .py files (CI python-lint enforces it)" >&2
  fi
fi
