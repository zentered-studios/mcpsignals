{
  "name": "mcpsignals",
  "version": "0.1.0",
  "description": "Drop-in instrumentation for MCP servers. Writes tool-call events to a warehouse you own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zentered-studios/mcpsignals.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/zentered-studios/mcpsignals#readme",
  "bugs": {
    "url": "https://github.com/zentered-studios/mcpsignals/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@google-cloud/bigquery": "^7.0.0 || ^8.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "pg": "^8.11.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "@google-cloud/bigquery": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google-cloud/bigquery": "^9.0.3",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.11.0",
    "pg": "^8.11.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "zod": "^4.6.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "observability",
    "instrumentation",
    "analytics"
  ]
}
